# GitHub OAuth app; register <deployment origin>/api/auth/callback/github as its callback.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# Comma-separated stable numeric GitHub account IDs; currently intended for one account.
JOBS_GITHUB_ACCOUNT_IDS=
# Neon pooled Postgres connection string. DATABASE_URL is accepted as an alternative.
NEON_DATABASE_URL=
# Bearer secret Vercel Cron sends to /api/jobs/discovery.
CRON_SECRET=
# Used for draft generation.
OPENAI_API_KEY=
