{
  "name": "job-search-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node --import tsx services/jobdesk/server.ts",
    "lint": "eslint .",
    "test": "tsx --test lib/*.test.ts",
    "test:truths": "playwright test --config=playwright.truths.config.ts",
    "jobs:start": "node --import tsx services/jobdesk/server.ts",
    "jobs:cli": "node --import tsx services/jobdesk/cli.ts",
    "test:jobdesk": "node --import tsx --test services/jobdesk/*.test.ts",
    "test:jobdesk:fuzz": "node --import tsx --test services/jobdesk/workflow-fuzz.test.ts",
    "jobs:mcp": "node services/jobdesk/mcp-server.mjs",
    "jobs:import": "node --import tsx scripts/import-linkedin-email-leads.ts",
    "test:jobdesk:browser": "playwright test --config=playwright.jobdesk.config.ts",
    "typecheck": "tsc --noEmit",
    "eval:resumes": "node --import tsx scripts/evaluate-resumes.ts",
    "test:resume-evals": "node --import tsx --test lib/resume-evaluation.test.ts services/jobdesk/resume-evaluation.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "0.5.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "cheerio": "^1.2.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.11.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.23.13",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "pdfjs-dist": "4.10.38",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "engines": {
    "node": ">=22"
  }
}
